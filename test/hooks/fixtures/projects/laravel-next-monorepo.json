{
  "description": "A Laravel API next to a Next.js app, without a manifest: both tracks must be reported.",
  "files": {
    "package.json": {
      "name": "acme-monorepo",
      "private": true,
      "workspaces": [
        "web"
      ]
    },
    "api/composer.json": {
      "name": "acme/api",
      "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
      },
      "require-dev": {
        "pestphp/pest": "^5.0"
      }
    },
    "api/artisan": "#!/usr/bin/env php\n<?php\n",
    "web/package.json": {
      "name": "web",
      "private": true,
      "dependencies": {
        "next": "16.3.6",
        "react": "19.2.0",
        "react-dom": "19.2.0"
      }
    },
    "web/src/app/page.tsx": "export default function Page() {\n  return null;\n}\n"
  }
}
