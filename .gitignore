!plugins/cross-stack-standard/templates/*/vendor/
coverage/
dist/
build/
.next/
.expo/
.turbo/
.cache/
fixture-report.json

# Secrets and local-only config
.env
.env.*
!.env.example
.claude/settings.local.json
CLAUDE.local.md

# Archives, OS and editor files
*.zip
.DS_Store
*.log
